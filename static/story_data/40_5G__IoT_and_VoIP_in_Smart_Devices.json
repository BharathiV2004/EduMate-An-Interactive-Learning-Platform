            "scene_image_path": "/static/images/scene_4.png",
            "dialogues_with_audio": [
                {
                    "character": "Dr. Lee",
                    "line": "In smart homes and offices, devices can automatically connect to help with communication tasks, like scheduling calls or sending reminders.",
